# --------------------------------------------------
# Ubuntu base
# --------------------------------------------------
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# --------------------------------------------------
# Install OS & Python 
# --------------------------------------------------
RUN apt-get update && apt-get install -y \
    openjdk-11-jdk \
    openjdk-17-jdk \
    python3.10 \
    python3.10-venv \
    python3.10-distutils \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------
# Create Hadoop-related users
# --------------------------------------------------
RUN groupadd -r airflow && \
    useradd -m -r -g airflow -s /bin/bash airflow && \
    groupadd -r hadoop && \
    useradd -m -r -g hadoop -s /bin/bash hadoop && \
    groupadd -r spark && \
    useradd -m -r -g spark -s /bin/bash spark && \
    echo "hadoop ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    echo "airflow ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    echo "spark ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN mkdir -p /tmp/yarn/local /tmp/yarn/logs && \
    chown -R root:root /tmp/yarn && \
    chmod -R 755 /tmp/yarn && \
    chmod 1777 /tmp

# --------------------------------------------------
# Hadoop installation
# --------------------------------------------------
ENV HADOOP_VERSION=3.3.6
ENV HADOOP_HOME=/opt/hadoop

COPY tmp/hadoop-${HADOOP_VERSION}.tar.gz /tmp/

RUN tar -xzf /tmp/hadoop-${HADOOP_VERSION}.tar.gz -C /opt && \
    mv /opt/hadoop-${HADOOP_VERSION} ${HADOOP_HOME} && \
    rm /tmp/hadoop-${HADOOP_VERSION}.tar.gz

# --------------------------------------------------
# Environment
# --------------------------------------------------
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV HADOOP_CONF_DIR=$HADOOP_HOME/etc/hadoop
ENV YARN_CONF_DIR=$HADOOP_CONF_DIR
ENV PYSPARK_PYTHON=/usr/bin/python3
ENV PYSPARK_DRIVER_PYTHON=/usr/bin/python3
ENV PATH=$JAVA_HOME/bin:$HADOOP_HOME/bin:$HADOOP_HOME/sbin:$PATH

# --------------------------------------------------
# HDFS directories
# --------------------------------------------------
RUN mkdir -p /data/hdfs/namenode \
             /data/hdfs/datanode && \
    chown -R hadoop:hadoop /data /opt/hadoop

# --------------------------------------------------
# Copy Hadoop configs
# --------------------------------------------------
RUN rm -f $HADOOP_CONF_DIR/hadoop-env.sh
COPY hadoop-env.sh $HADOOP_CONF_DIR/hadoop-env.sh
COPY core-site.xml $HADOOP_CONF_DIR/
COPY hdfs-site.xml $HADOOP_CONF_DIR/
COPY yarn-site.xml $HADOOP_CONF_DIR/

RUN chown -R hadoop:hadoop $HADOOP_CONF_DIR

RUN rm -rf /tmp/*

# --------------------------------------------------
# Install Pyspark and Python dependencies
# --------------------------------------------------
ENV DELTA_SPARK_VERSION=4.0.0
ENV SPARK_VERSION=4.0.1
COPY tmp/delta_spark-${DELTA_SPARK_VERSION}-py3-none-any.whl /tmp/
COPY tmp/pyspark-${SPARK_VERSION}.tar.gz /tmp/
RUN python3 -m pip install /tmp/pyspark-${SPARK_VERSION}.tar.gz && \
    python3 -m pip install /tmp/delta_spark-${DELTA_SPARK_VERSION}-py3-none-any.whl --upgrade-strategy only-if-needed

USER hadoop
WORKDIR /home/hadoop

# --------------------------------------------------
# Startup: HDFS + YARN
# --------------------------------------------------
CMD bash -c "\
  set -e && \
  java -version && \
  python3 --version && \
  \
  if [ ! -d /data/hdfs/namenode/current ]; then \
    hdfs namenode -format -force; \
  fi && \
  \
  hdfs --daemon start namenode && \
  hdfs --daemon start datanode && \
  until hdfs dfs -ls / >/dev/null 2>&1; do sleep 2; done && \
  \
  yarn --daemon start resourcemanager && \
  yarn --daemon start nodemanager && \
  until yarn node -list >/dev/null 2>&1; do sleep 2; done && \
  \
  hdfs dfs -mkdir -p /tmp /user/spark /user/airflow /user/hadoop /spark/spark-logs && \
  hdfs dfs -chown airflow:airflow /user/airflow && \
  hdfs dfs -chown hadoop:hadoop /user/hadoop && \
  hdfs dfs -chown spark:spark /user/spark && \
  hdfs dfs -chmod -R 755 /user/* /tmp /spark/ && \
  \
  hdfs dfs -mkdir -p /tmp/logs && \
  hdfs dfs -chmod -R 1777 /tmp/logs && \
  \
  hdfs dfs -mkdir -p /user/hive/warehouse && \
  hdfs dfs -chown -R spark:spark /user/hive && \
  \
  hdfs dfs -mkdir -p /user/spark/checkpoints/actors && \
  \
  echo 'HDFS + YARN READY' && \
  tail -f /dev/null \
"
